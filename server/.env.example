# Copy this file to server/.env and fill in your own values.
# server/.env is ignored by git. Never commit a real key.

# Your Gemini API key from Google AI Studio.
GEMINI_API_KEY=your_key_here

# Set to true to turn on commit summaries. Anything else keeps them off.
GEMINI_ENABLED=false

# Which Gemini model to use for summaries.
GEMINI_MODEL=gemini-3.5-flash-lite

# Most real Gemini calls allowed per server run. Restarting resets the count.
GEMINI_MAX_CALLS=30
